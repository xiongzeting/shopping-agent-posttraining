# ShopSimulator and OpenAI-compatible model services
SHOPSIM_BASE_URL=http://127.0.0.1:5700
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
SERVED_MODEL_NAME=shopping-agent

# Remote Teacher collection profile. Keep real credentials only in ignored .env.
SHOPPING_TEACHER_BASE_URL=https://example.invalid/v1
SHOPPING_TEACHER_API_KEY=replace-me
SHOPPING_TEACHER_MODEL=deepseek-v4-flash

# Offline trajectory Judge profile. This does not replace the evaluated Actor.
SHOPPING_JUDGE_BASE_URL=https://example.invalid/v1
SHOPPING_JUDGE_API_KEY=replace-me
SHOPPING_JUDGE_MODEL=deepseek-v4-pro

# Local-only SFT input. Put your downloaded checkpoint here or change this path.
BASE_MODEL=models/Qwen3.5-2B
# Current audited SFT dataset contract.
SFT_TRAIN_DATA=data/sft/train.jsonl
SFT_VALIDATION_DATA=data/sft/validation.jsonl
SFT_METADATA=data/sft/metadata.json
SFT_RECIPE_VARIANT=canonical

# Optional SFT run controls. Generated records remain under ignored outputs/.
SFT_MIN_GPU_MEMORY_GIB=94
SFT_MIN_FREE_GPU_MEMORY_GIB=92
SFT_MIN_FREE_DISK_GIB=50
# Installation itself needs less space; full run/adapter/merged paths still use the 50 GiB check.
SFT_SETUP_MIN_FREE_DISK_GIB=20
SFT_ADAPTER_DIR=outputs/models/sft-lora-expanded-v1
SFT_MERGED_DIR=outputs/models/sft-merged-expanded-v1
SFT_RUN_DIR=outputs/runs/sft-expanded-v1
SFT_MERGE=0
SFT_SWANLAB=0
SFT_SWANLAB_MODE=local
