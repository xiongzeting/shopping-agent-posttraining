{
  "tools": [
    {
      "class_name": "shopping_grpo.training.grpo.adapter.tools.ShopSimulatorTool",
      "config": {"type": "native"},
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "search_products",
          "description": "仅当最新 observation 显示“搜索功能是否可用: True”时搜索。query 应简洁，包含品类和最有区分度的品牌、型号、功能或规格；不得重复相同查询或机械复制整段需求。",
          "parameters": {
            "type": "object",
            "properties": {"query": {"type": "string"}},
            "required": ["query"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "shopping_grpo.training.grpo.adapter.tools.ShopSimulatorTool",
      "config": {"type": "native"},
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "open_product",
          "description": "打开最新 observation 当前搜索结果中列出的候选商品以核验价格、功能和规格；asin 必须原样取自该页面。",
          "parameters": {
            "type": "object",
            "properties": {"asin": {"type": "string"}},
            "required": ["asin"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "shopping_grpo.training.grpo.adapter.tools.ShopSimulatorTool",
      "config": {"type": "native"},
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "select_option",
          "description": "为当前商品选择规格。value 必须填写最新 observation 的 available_options 中与所需 label 对应的稳定 option_id（形如 opt_...），不得填写 label、导航按钮或历史页面 ID。同一规格轴只选一个值；选择后按完整 variant 的实际价格重新核验需求。",
          "parameters": {
            "type": "object",
            "properties": {"value": {"type": "string"}},
            "required": ["value"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "shopping_grpo.training.grpo.adapter.tools.ShopSimulatorTool",
      "config": {"type": "native"},
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "next_page",
          "description": "仅当当前页面显示 Next > 且当前页没有合适候选时翻到下一页以发现新商品；无参数，必须传 {}。",
          "parameters": {"type": "object", "properties": {}, "required": [], "additionalProperties": false}
        }
      }
    },
    {
      "class_name": "shopping_grpo.training.grpo.adapter.tools.ShopSimulatorTool",
      "config": {"type": "native"},
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "prev_page",
          "description": "仅当当前页面显示 < Prev 按钮时返回上一页；无参数，必须传 {}。",
          "parameters": {"type": "object", "properties": {}, "required": [], "additionalProperties": false}
        }
      }
    },
    {
      "class_name": "shopping_grpo.training.grpo.adapter.tools.ShopSimulatorTool",
      "config": {"type": "native"},
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "back_to_search",
          "description": "仅当当前页面显示 Back to Search 按钮时返回搜索页；无参数，必须传 {}。",
          "parameters": {"type": "object", "properties": {}, "required": [], "additionalProperties": false}
        }
      }
    },
    {
      "class_name": "shopping_grpo.training.grpo.adapter.tools.ShopSimulatorTool",
      "config": {"type": "native"},
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "buy_now",
          "description": "购买当前商品并结束任务。仅当最新 observation 显示 Buy Now 时可调用。当前完整 variant 的品类正确且用户明确要求均已满足时，必须立即调用，不得继续搜索、比较或重复核验。充分探索后仍无完全匹配商品时，也可购买品类正确、在已核验候选中整体最符合且可接受的候选。只依据用户需求和当前可见商品信息判断，无需寻找任何预设商品。无参数，必须传 {}。",
          "parameters": {"type": "object", "properties": {}, "required": [], "additionalProperties": false}
        }
      }
    },
    {
      "class_name": "shopping_grpo.training.grpo.adapter.tools.ShopSimulatorTool",
      "config": {"type": "native"},
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "finish_without_purchase",
          "description": "主动结束且不购买，这不是成功。环境不再按检索是否充分细分停止类型，调用后统一按 early_abstain 终止；仅当经过有实质差异的搜索和候选核验后仍没有可接受商品，且没有明显值得继续核验的候选时使用。",
          "parameters": {
            "type": "object",
            "properties": {"reason": {"type": "string", "enum": ["no_suitable_product"]}},
            "required": ["reason"],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
